{
    "name": "Flutter Development Container",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "runArgs": [
        "-v",
        "/dev/bus/usb:/dev/bus/usb",
        "-v",
        "/var/run/avahi-daemon/socket:/var/run/avahi-daemon/socket"
    ],
    "forwardPorts": [8081, 5037],
    "remoteUser": "root"
}